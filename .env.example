# All settings are optional — the API runs with zero configuration.
# Copy to .env for local overrides, or set them in your host's dashboard.
# Every variable is prefixed CVBIO_.

# --- Recommended in production -------------------------------------------
# Upstream APIs ask for a contactable User-Agent. Set this to your repo.
# CVBIO_USER_AGENT=cabo-verde-biodiversity/1.0 (+https://github.com/you/repo)

# Lock the portal down to specific origins. Accepts a comma-separated list
# or a JSON array; "*" (the default) allows any origin.
# CVBIO_CORS_ORIGINS=https://your-portal.example,https://www.your-portal.example

# --- Optional ------------------------------------------------------------
# Unlocks live WDPA protected-area data (free key from protectedplanet.net),
# replacing the bundled official INGT dataset. Adds IUCN categories and
# marine/terrestrial classification.
# CVBIO_PROTECTED_PLANET_TOKEN=

# Cache lifetimes in seconds. Longer = fewer upstream calls, staler data.
# CVBIO_CACHE_TTL=900
# CVBIO_CACHE_TTL_LONG=86400

# Upstream HTTP behaviour.
# CVBIO_HTTP_TIMEOUT=20
# CVBIO_HTTP_RETRIES=2

# NOTE: PORT is NOT prefixed and is injected by the host (Railway, Render,
# Fly, Cloud Run). Do not set it yourself unless running locally.
